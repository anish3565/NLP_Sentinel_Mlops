# App-level secrets for the Flask app itself.
# This is NOT for AWS credentials — those live in ~/.aws/credentials
# via `aws configure --profile terraform-deployer` and Terraform reads
# them through the `profile` setting in main.tf.
#
# This file must be gitignored (see below) and never committed.

FLASK_SECRET_KEY=replace-with-a-random-string
FLASK_ENV=production

# Add any other app-level values your Flask code actually reads via
# os.environ.get(...) — for example, if your app logs to or reads
# from S3/DVC directly rather than through the EKS pod's IAM role:
# AWS_DEFAULT_REGION=ap-south-1
